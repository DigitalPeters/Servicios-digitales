# Copia este archivo como .env y coloca tus datos reales
# PowerShell: Copy-Item .env.example .env

PORT=3000
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Conexion local PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=servicios_digitales
PGUSER=postgres
PGPASSWORD=TU_PASSWORD_POSTGRES

# Si usas Render/Neon/Railway puedes usar DATABASE_URL en lugar de lo anterior
# DATABASE_URL=postgres://usuario:password@host:5432/dbname

# Dominio base para subdominios de clientes
PANEL_BASE_DOMAIN=serviciosdigitalespeters.com

# Correo (opcionales)
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# FROM_EMAIL=onboarding@resend.dev

# Avisos automáticos de vencimiento de cuentas madre (días antes)
# Por defecto: 7,3,1,0 = 7 días, 3 días, 1 día y el día que vence
# MOTHER_EXPIRATION_NOTIFICATION_DAYS=7,3,1,0
